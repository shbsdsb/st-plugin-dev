{
  "name": "ui-tool-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI 工具库插件:白色玻璃主题(背景 + 插槽美化)+ window.__uiTools__ 前端工具库(13 种悬浮工具)+ theme 主题引擎(小参数 API + install 全量 css/html/js 替换)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "kind": "web",
      "path": "lib/index.cjs",
      "immed": true,
      "inject": ["st-ui-slots"]
    }
  }
}
