{
  "name": "multi-session-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多会话管理:右侧插槽会话列表 + multiSession 服务(增删查/消息存取/active 会话)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "kind": "web", "path": "lib/index.cjs", "immed": true, "inject": ["ui-polish", "st-ui-slots", "ui-tool-plugin"] }
  }
}
