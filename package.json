{
  "name": "st-ui-beautify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前端美化插件:白色玻璃拟态主题(背景 + 5 插槽容器玻璃化)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "kind": "web",
      "path": "lib/index.cjs",
      "immed": true
    }
  }
}
