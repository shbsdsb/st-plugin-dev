{
  "name": "ui-tool-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI 工具库插件(纯工具):window.__uiTools__ 13 种悬浮工具;主题职责已移交 ui-polish(消费 --ui-* token)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "kind": "web",
      "path": "lib/index.cjs",
      "immed": true,
      "inject": ["ui-polish", "st-ui-slots"]
    }
  }
}
