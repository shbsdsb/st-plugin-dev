{
  "name": "st-ui-slots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前端基础插件:UI 插槽布局(导航/左右侧边栏/主页面/悬浮层)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "kind": "web",
      "path": "lib/index.cjs",
      "immed": true,
      "inject": ["ui-polish"]
    }
  }
}
