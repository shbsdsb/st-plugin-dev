{
  "name": "prompt-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前后端一体插件:预设 Prompt 表单/条目管理 + 按序组装 messages 发送 LLM(cordis v4)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "kind": "web", "path": "lib/index.cjs", "immed": true, "inject": ["st-ui-slots", "ui-tool-plugin"] }
  }
}
